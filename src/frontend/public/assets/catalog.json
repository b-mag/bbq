  "conventions": {
    "view": "three-quarter / ¾ (LTTP + Chaos Engine). Sprites are feet-anchored on the world point. Buildings show a south face; the door is on the south wall. Enter by walking up from the south; exit interiors through the bottom door.",
    "pixelGrid": 32,
    "imageSmoothing": false,
    "characterSheet": {
      "cell": "width x height from the sprite manifest (players 32x32, Gronk 48x48)",
      "columns": "walk frames (idle = column 0)",
      "walkRows": "0 .. directions-1",
      "attackRows": "directions .. 2*directions-1 (optional)",
      "facingIndex": { "0": "down / south / toward camera", "1": "left / west", "2": "right / east", "3": "up / north / away" },
      "playerSheetPixels": "128x256 (4 walk columns, 4 walk rows + 4 attack rows)",
      "note": "If a replacement sheet is Down/Right/Left/Up instead of D,L,R,U, say so here and in the sprite entry facingOrder."
    },
    "propSheet": {
      "frames": 1,
      "facing": "south facade toward camera. No direction rows.",
      "anchor": "feet. The bottom of the PNG sits on the world (x, y) tile center.",
      "door": "implied on the south face of enterable buildings"
    },
    "tilesetAtlas": {
      "tileSize": 32,
      "columns": 8,
      "index": "row-major: sx = (index % 8) * 32, sy = floor(index / 8) * 32",
      "variants": "consecutive cells after index, chosen by worldX/worldY hash",
      "frames": "consecutive cells after index, animated"
    },
    "howToAddArt": [
      "Drop a PNG in sprites/ or tilesets/ named for its id (player_a.png, organic_house.png, …).",
      "Add or edit the id in sprites/manifest.json or tilesets/manifest.json.",
      "Add a matching entry in this catalog (file, cell, facing, who uses it, map placement if unique).",
      "Several ids may share one PNG via manifest `file`.",
      "Rebuild / hard-refresh; the game server wwwroot copy is stale until frontend is rebuilt into it."
    ]
  },
